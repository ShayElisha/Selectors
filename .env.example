MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
PORT=3001

# Required in production — long random string (32+ chars). Signs login session tokens.
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional: seed default manager email on data reset
ADMIN_EMAIL=admin@example.com
APP_NAME=שיבוצון · GATE OUT

# SMTP (nodemailer) — required to deliver temp / reset passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GATE OUT <noreply@example.com>"

# Optional: public app URL shown as a login button in emails
APP_URL=https://your-app.vercel.app
