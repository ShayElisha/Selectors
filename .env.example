MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Inspectors module uses its own database. Selectors stay on MONGODB_URI.
MONGODB_URI_INSPECTORS=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/shibutzon?retryWrites=true&w=majority
PORT=3001

# Required in production — long random string (32+ chars). Signs login session tokens.
SESSION_SECRET=change-me-to-a-long-random-secret

# Super admin signs in with this phone and password, then approves organizations.
# Use a phone that is not a manager phone. Password: 8+ chars, uppercase, digit, symbol.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Optional: seed default manager email on data reset
ADMIN_EMAIL=admin@example.com
APP_NAME=שיבוצון · GATE OUT

# SMTP (nodemailer) — required to deliver temp / reset passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name in code is always the app name. The address must be the mailbox you authenticate as.
# After you own a domain, switch this host/user/pass/from to that provider and add DNS:
#   SPF   TXT @     v=spf1 include:<provider> ~all
#   DKIM  TXT <selector>._domainkey   <public key from the provider>
#   DMARC TXT _dmarc v=DMARC1; p=none; rua=mailto:dmarc@your-domain
# APP_URL must use that same domain, not a *.vercel.app preview address.
SMTP_FROM="שיבוצון <noreply@example.com>"

# Optional: public app URL shown as a login button in emails
APP_URL=https://your-app.vercel.app
